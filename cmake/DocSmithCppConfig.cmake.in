@PACKAGE_INIT@

# The project using DocSmith++ defines the targets it links (see
# DocSmithCppDependencies.cmake for why); this only checks they're there.
include("${CMAKE_CURRENT_LIST_DIR}/DocSmithCppDependencies.cmake")
docsmithcpp_check_dependencies(@DOCSMITHCPP_MARKDOWN@ _docsmithcpp_missing)
if(_docsmithcpp_missing)
    set(DocSmithCpp_FOUND FALSE)
    set(DocSmithCpp_NOT_FOUND_MESSAGE "${_docsmithcpp_missing}")
    unset(_docsmithcpp_missing)
    return()
endif()
unset(_docsmithcpp_missing)

include("${CMAKE_CURRENT_LIST_DIR}/DocSmithCppTargets.cmake")
check_required_components(DocSmithCpp)
