@PACKAGE_INIT@

# The library links these privately, but a static library still needs them at
# link time, so consumers must be able to find them too.
include(CMakeFindDependencyMacro)
find_dependency(pugixml CONFIG)
find_dependency(miniz CONFIG)
if(@DOCSMITHCPP_MARKDOWN@)
    find_dependency(md4c CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/DocSmithCppTargets.cmake")
check_required_components(DocSmithCpp)
